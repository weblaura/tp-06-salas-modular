{
  "name": "tp-06-salas-modular",
  "version": "1.0.0",
  "description": "Aplicación web de reservas de salas de estudio, reorganizada en módulos.",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:local": "node --env-file=.env src/index.js",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lint": "eslint src",
    "check": "npm run format:check && npm run lint"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0"
  }
}
